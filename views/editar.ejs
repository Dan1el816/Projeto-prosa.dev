<!DOCTYPE html>
<html lang="pt-br">
	<%- include("partials/head.ejs") %>
	<body class="compose-layout">
		<%- include("partials/header.ejs") %>

		<main class="compose-page">
			<form action="/editar/<%= post.id %>" method="POST" class="compose-form">
				<input type="hidden" name="id" value="<%= post.id %>" />

				<div class="compose-fields">
					<label class="visually-hidden" for="titulo">Título</label>
					<input
						class="compose-title"
						type="text"
						id="titulo"
						name="titulo"
						placeholder="Título"
						autocomplete="off"
						value="<%= post.titulo %>"
						maxlength="120"
						required
					/>

					<label class="visually-hidden" for="corpotexto">Conteúdo</label>
					<textarea
						class="compose-body"
						id="corpotexto"
						name="conteudo"
						placeholder="Conte sua história..."
						rows="8"
						maxlength="10000"
						required
					><%= post.conteudo %></textarea>
						
					<button type="submit" class="submit-post">Salvar alterações</button>
				</div>
			</form>
		</main>


		<%- include("partials/footer.ejs") %>
	</body>
</html>
