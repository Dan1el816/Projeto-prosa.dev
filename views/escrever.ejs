<!DOCTYPE html>
<html lang="pt-br">
  <%- include("partials/head.ejs") %>
  <body class="compose-layout">
    <%- include("partials/header.ejs") %>

    <main class="compose-page">
      <form action="/enviar" method="POST" class="compose-form">
        <div class="compose-fields">
          <label class="visually-hidden" for="titulo">Título</label>
          <input
            class="compose-title"
            type="text"
            id="titulo"
            name="titulo"
            placeholder="Título"
            autocomplete="off"
            maxlength="120"
            required
          />

          <label class="visually-hidden" for="corpotexto">Conteúdo</label>
          <textarea
            class="compose-body"
            id="corpotexto"
            name="conteudo"
            placeholder="Conte sua história..."
            rows="8"
            maxlength="10000"
            required
          ></textarea>
          <button type="submit" class="submit-post">Publicar</button>
        </div>
      </form>
    </main>


    <%- include("partials/footer.ejs") %>
  </body>
</html>