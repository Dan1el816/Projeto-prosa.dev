<!DOCTYPE html>
<html lang="pt-br">
  <%- include("partials/head.ejs") %>
  <body>
    <%- include("partials/header.ejs") %>


    <% if (posts.length === 0) { %>
      <main>
        <h1 class="h1msg_nopost">Opa! Parece que você não escreveu nenhum post ainda :(</h1>
        <h3 class="h3msg_nopost">Que tal começar criando seu primeiro post clicando em 'Escrever' no canto superior direito?</h3>
      </main>
    <% } else { %>
      <main class="posts-page">
        <section class="posts-container" aria-label="Posts publicados">
          <% posts.forEach((post) => { %>
            <a class="post-card" href="/post/<%= post.id %>">
              <h1 class="post-title"><%= post.titulo %></h1>
              <p class="post-content"><%= post.conteudo %></p>
              <span class="post-link-label">Ler post <span aria-hidden="true">&rarr;</span></span>
            </a>
          <% }) %>
        </section>
      </main>
    <% } %>


    <%- include("partials/footer.ejs") %>
  </body>
</html>