<!DOCTYPE html>
<html lang="pt-br">
  <%- include("partials/head.ejs") %>
  <body>
    <%- include("partials/header.ejs") %>

    <% if (mensagem) { %>
      <p class="success-message" role="status"><%= mensagem %></p>
    <% } %>

    <% if (posts.length === 0) { %>
      <main>
        <h1 class="h1msg_nopost">Opa! Parece que você não escreveu nenhum post ainda :(</h1>
        <h3 class="h3msg_nopost">Que tal começar criando seu primeiro post clicando em 'Escrever' no canto superior direito?</h3>
      </main>
    <% } else { %>
      <main class="posts-page">
        <section class="posts-container" aria-label="Posts publicados">
          <% posts.forEach((post) => { %>
            <article class="post-card">
              <div class="post-card-top">
                <a class="post-card-link" href="/post/<%= post.id %>">
                  <h1 class="post-title"><%= post.titulo %></h1>
                </a>

                <details class="post-menu">
                  <summary class="post-menu-trigger" aria-label="Opções do post">
                    <span aria-hidden="true">⋯</span>
                  </summary>

                  <div class="post-menu-panel">
                    <a id="editar_<%= post.id %>" class="post-action post-action-edit" href="/editar/<%= post.id %>">Editar</a>
                    <form action="/excluir/<%= post.id %>" method="POST" onsubmit="return confirm('Tem certeza que deseja excluir este post?');">
                      <button id="excluir_<%= post.id %>" type="submit" class="post-action post-action-delete">Excluir</button>
                    </form>
                  </div>
                </details>
              </div>

              <p class="post-content"><%= post.conteudo %></p>
              <p class="post-date">
                Publicado em <%= new Date(post.createdAt).toLocaleDateString("pt-BR", { dateStyle: "long" }) %>
                <% if (post.updatedAt) { %>
                  · Atualizado em <%= new Date(post.updatedAt).toLocaleDateString("pt-BR", { dateStyle: "long" }) %>
                <% } %>
              </p>
              <a class="post-link-label" href="/post/<%= post.id %>">Ler post <span aria-hidden="true">&rarr;</span></a>
            </article>
          <% }) %>
        </section>
      </main>
    <% } %>

    <script src="/script.js" defer></script>

    <%- include("partials/footer.ejs") %>
  </body>
</html>